{
  "name": "frontend",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc || true && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && NODE_ENV=development electron .\"",
    "electron:build": "ELECTRON_BUILD=true npm run build && electron-builder",
    "electron:dist": "ELECTRON_BUILD=true npm run build && electron-builder --publish=never"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.29.1-dev132.0",
    "@mlc-ai/web-llm": "^0.2.79",
    "@monaco-editor/react": "^4.7.0",
    "@motherduck/wasm-client": "^0.6.6",
    "@nivo/bar": "^0.99.0",
    "@nivo/bump": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@nivo/scatterplot": "^0.99.0",
    "@radix-ui/react-slot": "^1.2.2",
    "@shadcn/ui": "^0.0.4",
    "@tailwindcss/vite": "^4.1.5",
    "@types/d3": "^7.4.3",
    "@types/papaparse": "^5.3.15",
    "apache-arrow": "^20.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "compromise": "^14.14.4",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.11.1",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.507.0",
    "papaparse": "^5.5.2",
    "plausible-tracker": "^0.3.9",
    "prismjs": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.30.0",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "recharts": "^2.15.3",
    "sql-formatter": "^15.6.1",
    "tailwind-merge": "^1.14.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4.1.5",
    "ts-jest": "^29.2.5",
    "tw-animate-css": "^1.2.9",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "license": "AGPL-3.0-only",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.datakit.app",
    "productName": "Datakit",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.cjs",
      "node_modules/**/*",
      "public/datakit.png"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "public/datakit.png",
      "fileAssociations": [
        {
          "ext": "csv",
          "name": "CSV File",
          "description": "Comma-separated values file",
          "mimeType": "text/csv",
          "icon": "public/datakit.png"
        },
        {
          "ext": "json",
          "name": "JSON File", 
          "description": "JavaScript Object Notation file",
          "mimeType": "application/json",
          "icon": "public/datakit.png"
        },
        {
          "ext": ["xlsx", "xls"],
          "name": "Excel File",
          "description": "Microsoft Excel spreadsheet",
          "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
          "icon": "public/datakit.png"
        },
        {
          "ext": "parquet",
          "name": "Parquet File",
          "description": "Apache Parquet columnar storage file",
          "mimeType": "application/x-parquet",
          "icon": "public/datakit.png"
        }
      ]
    },
    "win": {
      "icon": "public/datakit.png",
      "fileAssociations": [
        {
          "ext": "csv",
          "name": "CSV File",
          "description": "Comma-separated values file",
          "mimeType": "text/csv",
          "icon": "public/datakit.png"
        },
        {
          "ext": "json", 
          "name": "JSON File",
          "description": "JavaScript Object Notation file",
          "mimeType": "application/json",
          "icon": "public/datakit.png"
        },
        {
          "ext": ["xlsx", "xls"],
          "name": "Excel File",
          "description": "Microsoft Excel spreadsheet", 
          "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
          "icon": "public/datakit.png"
        },
        {
          "ext": "parquet",
          "name": "Parquet File",
          "description": "Apache Parquet columnar storage file",
          "mimeType": "application/x-parquet",
          "icon": "public/datakit.png"
        }
      ]
    },
    "linux": {
      "icon": "public/datakit.png",
      "category": "Development",
      "mimeTypes": [
        "text/csv",
        "application/json",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "application/vnd.ms-excel",
        "application/x-parquet"
      ]
    }
  }
}
